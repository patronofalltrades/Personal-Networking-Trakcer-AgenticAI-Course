# Public browser endpoints from the Neon Console
NEXT_PUBLIC_NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.build/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-project.apirest.region.aws.neon.build/neondb/rest/v1

# Public canonical URL used for social metadata after deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated providers configured in Neon Auth: google,microsoft
NEXT_PUBLIC_AUTH_SOCIAL_PROVIDERS=

# Local-only database administration; never add this to Vercel
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local-only accounts used by `npm run test:integration`
TEST_USER_A_EMAIL=user-a@example.com
TEST_USER_A_PASSWORD=replace-with-a-test-password
TEST_USER_B_EMAIL=user-b@example.com
TEST_USER_B_PASSWORD=replace-with-a-test-password
